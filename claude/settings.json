{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787/w/claude",
    "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1",
    "ENABLE_TOOL_SEARCH": "auto"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jnx/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jnx/.bun/install/global/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jnx/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jnx/.bun/install/global/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jnx/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jnx/.bun/install/global/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jnx/.bun/bin/caveman' shrink-hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jnx/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jnx/.bun/install/global/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jnx/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jnx/.bun/install/global/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jnx/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jnx/.bun/install/global/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jnx/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jnx/.bun/install/global/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jnx/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jnx/.bun/install/global/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jnx/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jnx/.bun/install/global/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/jnx/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/jnx/.bun/install/global/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "rose-pine@claude-themes": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claude-themes": {
      "source": {
        "source": "github",
        "repo": "matcra587/claude-themes"
      }
    }
  },
  "syntaxHighlightingDisabled": false,
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "custom:rose-pine:rose-pine"
}
